# Local inference only. ASR/chat use Qwen + vLLM; TTS uses Chatterbox; Jawi uses Kraken OCR.
ASR_WS_URL=ws://127.0.0.1:8001/stream
ASR_HEALTH_URL=http://127.0.0.1:8001/health
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen/Qwen3-0.6B
TTS_BASE_URL=http://127.0.0.1:8091
VISION_BASE_URL=http://127.0.0.1:8002
VISION_MODEL=culturalheritagenus/Jawi-OCR-Kraken-v1
ASR_GPU_MEMORY=0.35
ASR_MAX_MODEL_LEN=1024
ASR_MAX_BATCHED_TOKENS=512
ASR_LANGUAGE=Malay
CHAT_GPU_MEMORY=0.32
CHAT_MAX_MODEL_LEN=1536
CHAT_MAX_BATCHED_TOKENS=512
# Optional for authenticated self-hosted servers.
VLLM_API_KEY=
# Linux: point these to executables in your already-installed vLLM environment.
# VLLM_BIN=/home/you/.venvs/vllm/bin/vllm
# ASR_PYTHON=/home/you/.venvs/vllm/bin/python
# Optional separate Python environments, created by scripts/setup-linux.sh.
# CHATTERBOX_PYTHON=/absolute/path/.venv-tts/bin/python
# VISION_PYTHON=/absolute/path/.venv-ocr/bin/python
PORT=3001
